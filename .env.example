# Scientific RAG API - environment configuration
# Copy to `.env` and fill in ONE provider (or rely on auto-detection).
# Real environment variables take precedence over this file.

# LLM provider
# auto   : first available of openai -> anthropic -> deepseek -> ollama
# ollama : local-only setup, no API key needed
LLM_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Retrieval / ingestion
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=750
CHUNK_OVERLAP=140

# Service (defaults shown, uncomment to override)
# PDF_DIR=data/raw_pdfs
# CHROMA_DIR=data/chroma
# COLLECTION_NAME=scientific_docs
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_TOKENS=1024
